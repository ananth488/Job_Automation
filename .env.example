# ==========================================
# Database Configuration
# ==========================================
# 1. Neon Serverless Postgres (Recommended for Production & Cloud Deployments: Render, Railway, Vercel)
#    Get free persistent DB at https://neon.tech (Data never gets deleted during redeploys):
# DATABASE_URL=postgresql://user:password@ep-xyz-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# 2. Local SQLite (Default fallback for local offline testing):
DATABASE_URL=sqlite:///./job_automation.db

# JWT Auth
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider
ANTHROPIC_API_KEY=your-anthropic-api-key

# File Upload
UPLOAD_DIR=./uploads

# Default User (created on first run)
DEFAULT_USER_EMAIL=demo@jobbot.com
DEFAULT_USER_PASSWORD=password123

# Email Notifications (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
NOTIFICATION_EMAIL=your-email@gmail.com

# Frontend
# In production (e.g. Vercel), point to your live Render backend:
NEXT_PUBLIC_API_URL=https://job-automation-2-fe7i.onrender.com/api/v1
# For local testing fallback:
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

