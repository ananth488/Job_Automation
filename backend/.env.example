# Database Configuration
# Neon Serverless PostgreSQL (Persistent on free cloud hosts like Render/Railway/Fly/Vercel):
# DATABASE_URL=postgresql://user:password@ep-xyz-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# SQLite fallback (Local offline development):
DATABASE_URL=sqlite:///./job_automation.db

# JWT Auth
SECRET_KEY=super-secret-key-change-in-production-abc123xyz
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider
ANTHROPIC_API_KEY=

# File Upload
UPLOAD_DIR=./uploads

# Default User
DEFAULT_USER_EMAIL=ananthslvm28@gmail.com
DEFAULT_USER_PASSWORD=password123

